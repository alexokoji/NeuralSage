# ==== Application ====
APP_NAME=NeuralTrade
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==== Database (MongoDB) ====
MONGODB_URL=mongodb://localhost:27017/neuraltrade
MONGODB_DB_NAME=neuraltrade

# ==== Redis ====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==== Security ====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_super_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# AES-256 key for API-key-at-rest encryption.
# Generate with: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_44_char_urlsafe_base64_32byte_key

# ==== Groq Cloud — AI brain for trading analysis & the AI assistant ====
# Free tier available — get your key at https://console.groq.com (no credit card needed).
# Leave blank to disable AI features (the platform still works; they degrade gracefully).
GROQ_API_KEY=

# ==== Rate limiting ====
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ==== Exchanges ====
BYBIT_REST_URL=https://api.bybit.com
BYBIT_TESTNET_REST_URL=https://api-testnet.bybit.com
BYBIT_WS_PUBLIC_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_WS_PUBLIC_TESTNET_URL=wss://stream-testnet.bybit.com/v5/public/linear

BITGET_REST_URL=https://api.bitget.com
BITGET_WS_PUBLIC_URL=wss://ws.bitget.com/v2/ws/public

# ==== Trading defaults (hard caps) ====
MAX_RISK_PER_TRADE_PCT=2.0
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_CONCURRENT_TRADES=5
MAX_CONSECUTIVE_LOSSES=3
TRADE_LOOP_INTERVAL_SECONDS=15
OPTIMIZATION_INTERVAL_HOURS=6
